{
  "name": "@francocarballar/pi-turn-tps",
  "version": "0.1.0",
  "description": "Aggregated turn tokens per second for Pi, excluding tools and gaps between model calls.",
  "type": "module",
  "license": "MIT",
  "author": "Franco Carballar",
  "repository": { "type": "git", "url": "git+https://github.com/francocarballar/pi-turn-tps.git" },
  "homepage": "https://github.com/francocarballar/pi-turn-tps#readme",
  "bugs": { "url": "https://github.com/francocarballar/pi-turn-tps/issues" },
  "keywords": ["pi-package", "pi", "extension", "tokens-per-second", "tps"],
  "engines": { "node": ">=22.19.0" },
  "files": ["extensions/", "src/", "README.md", "LICENSE", "CHANGELOG.md"],
  "pi": { "extensions": ["./extensions/turn-tps.ts"] },
  "peerDependencies": { "@earendil-works/pi-coding-agent": "*" },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.1.0",
    "@types/node": "22.19.19",
    "typescript": "6.0.3"
  },
  "scripts": {
    "test": "node --experimental-strip-types --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "check:package": "node --experimental-strip-types scripts/check-package.ts",
    "verify": "npm run typecheck && npm test && npm run check:package"
  }
}
